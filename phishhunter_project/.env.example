# Copie ce fichier en ".env" et renseigne tes vrais tokens.
# ".env" est déjà listé dans .gitignore — ne l'en retire jamais.
# Ce fichier ("*.example"), lui, est fait pour être partagé/commité : il ne
# doit contenir QUE des placeholders, jamais une vraie clé.

# Utilisé par src/llm/explain.py pour générer l'explication en langage
# naturel du score (Hugging Face Inference API, plusieurs modèles de repli).
# Token gratuit (rôle "Read" suffit) : https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Utilisé par src/agent/agent_loop.py — l'agent autonome qui décide seul,
# via tool use, de bloquer/escalader/laisser passer un email. Nécessaire
# uniquement si tu veux tester ce mode agentique depuis le dashboard.
# Clé gratuite, sans carte bancaire : https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optionnel — URL du webhook CrisisBot, appelé quand un email est classé
# à haut risque. Valeur par défaut déjà correcte en local (voir
# src/crisisbot_client.py) : à changer seulement si CrisisBot tourne sur
# une autre machine/port.
# CRISISBOT_URL=http://localhost:8878/api/webhook/incident

# NOTE : ANTHROPIC_API_KEY n'est plus utilisée par le code actuel — elle ne
# servait qu'à src/tools.py, une ancienne version de l'agent (avant le passage
# à Groq) qui n'est plus importée nulle part. Pas besoin de la renseigner ;
# elle sera retirée définitivement quand ce fichier obsolète sera supprimé.