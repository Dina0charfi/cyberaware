# Copie ce fichier en ".env" et renseigne tes vrais tokens si besoin.
# ".env" est listé dans .gitignore — ne l'en retire jamais.
# Ce fichier ("*.example") est fait pour être partagé/commité : uniquement
# des placeholders ici, jamais une vraie clé.

# Optionnel. Sans cette clé, DarkWatch continue de fonctionner normalement :
# la décision (reset_password / notify_only / escalate_ciso / ignore) bascule
# automatiquement sur des règles simples (voir llm_summary.py, _fallback_decision).
# Clé gratuite, sans carte bancaire : https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Port du dashboard DarkWatch.
DARKWATCH_PORT=8877

# Source de la liste des comptes à surveiller. "file" (par défaut) lit
# emails_example.txt. "active_directory" est préparé (voir email_sources.py,
# from_active_directory()) mais lève NotImplementedError tant qu'aucun
# vrai annuaire n'est branché — ne pas activer sans avoir implémenté cette
# fonction.
DARKWATCH_EMAIL_SOURCE=file

# Mets à "1" pour activer la boucle de revérification automatique en tâche
# de fond (toutes les 45s). Laissé vide/absent par défaut, comme les autres
# agents, pour que rien ne se déclenche tout seul en dehors d'une démo
# explicite (voir launch_all.py --simulate).
# DARKWATCH_AUTO_SCAN=1

# Optionnel — URL du webhook CrisisBot, appelé quand une fuite est classée
# high/critical. Valeur par défaut déjà correcte en local.
# CRISISBOT_URL=http://localhost:8878/api/webhook/incident
