# Copie ce fichier en ".env" et renseigne tes vrais tokens si besoin.
# ".env" est listé dans .gitignore — ne l'en retire jamais.
# Ce fichier ("*.example") est fait pour être partagé/commité : uniquement
# des placeholders ici, jamais une vraie clé.

# Optionnel. Sans ce token, aucune explication en langage naturel n'est
# générée pour la décision (voir llm_explanation.py, plusieurs modèles de
# repli essayés : Qwen2.5-7B, Zephyr-7B, Llama-3.2-3B) — le score de risque
# et la décision par seuils continuent de fonctionner normalement.
# Token gratuit (rôle "Read" suffit) : https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Secret partagé attendu sur /api/webhook/signin-event, pour qu'un vrai
# SIEM/Entra ID authentifie ses appels. Le code a une valeur par défaut
# (voir app.py, SENTINEL_WEBHOOK_SECRET_DEFAULT) — à redéfinir ici avant
# toute exposition réseau réelle de ce endpoint.
SENTINEL_WEBHOOK_SECRET=your_webhook_secret_here

# Optionnel — URL du webhook CrisisBot, appelé quand une connexion est
# escaladée à un humain. Valeur par défaut déjà correcte en local.
# CRISISBOT_URL=http://localhost:8878/api/webhook/incident
