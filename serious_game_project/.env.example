# Clé Groq (gratuite) pour la génération du texte narratif à chaque tentative.
# Sans cette variable, le jeu reste jouable : un texte pré-écrit prend le relais.
GROQ_API_KEY=your_groq_api_key_here

# Modèle Groq utilisé pour la narration (optionnel, valeur par défaut ci-dessous).
GROQ_MODEL=llama-3.3-70b-versatile

# Port d'écoute du serveur du jeu (optionnel, 8880 par défaut — distinct des
# 5 autres agents, qui utilisent 8000/8877/8878/8001/8002/8003).
SERIOUSGAME_PORT=8880

# URL publique utilisée pour construire le VRAI lien de tracking inséré dans
# un email envoyé pour de vrai (voir mailer.py). Par défaut, localhost — donc
# cliquable uniquement depuis cette même machine. Pour qu'un vrai destinataire
# externe (téléphone, autre PC) puisse cliquer, mets ici l'IP locale de ce
# poste (ex. http://192.168.1.42:8880) ou une URL de tunnel (ngrok...).
SERIOUSGAME_PUBLIC_URL=http://localhost:8880

# --- Envoi d'un VRAI email (optionnel) --------------------------------------
# Laisse ces 3 variables vides pour rester en mode "affiché dans le navigateur
# uniquement" (comportement par défaut, rien à configurer).
#
# Pour Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton adresse,
# et SMTP_PASSWORD = un "mot de passe d'application" généré
# https://myaccount.google.com/apppasswords (nécessite la validation en 2
# étapes activée sur le compte) — JAMAIS ton vrai mot de passe Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=Simulation CyberAware

# --- Envoi d'un VRAI message WhatsApp, automatique (optionnel) --------------
# Laisse ces 2 variables vides pour rester en mode "affiché dans le navigateur
# uniquement" (comportement par défaut, rien à configurer).
#
# GREEN API (https://green-api.com) transforme ton propre téléphone (avec
# WhatsApp) en passerelle d'envoi — même principe que httpSMS pour le SMS.
#   1. Crée un compte sur https://console.green-api.com
#   2. Crée une instance (le plan gratuit "Developer" suffit pour tester)
#   3. Scanne le QR code affiché avec l'appli WhatsApp de ton téléphone
#      (Paramètres > Appareils liés > Lier un appareil)
#   4. Récupère idInstance et apiTokenInstance affichés dans la console.
GREENAPI_ID_INSTANCE=your_id_instance_here
GREENAPI_API_TOKEN=your_api_token_here