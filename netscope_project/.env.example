# Copie ce fichier en ".env" et renseigne tes vrais tokens si besoin.
# ".env" est listé dans .gitignore — ne l'en retire jamais.
# Ce fichier ("*.example") est fait pour être partagé/commité : uniquement
# des placeholders ici, jamais une vraie clé.

# Optionnel. Sans cette clé, aucune explication en langage naturel n'est
# générée par le LLM (voir src/netscope_agent/llm.py) — le score, le niveau
# de risque et les facteurs SHAP restent calculés normalement, ce n'est que
# le texte de synthèse qui n'est pas rédigé.
# Clé gratuite, sans carte bancaire : https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Secret partagé attendu sur /webhook/traffic-event (paramètre d'URL
# ?x_webhook_secret=...), pour qu'un firewall/proxy externe authentifie ses
# appels. Le code a une valeur par défaut volontairement explicite
# ("change-moi-avant-toute-vraie-utilisation") pour qu'on ne l'oublie pas
# avant une vraie intégration — à définir ici avant toute exposition réseau
# réelle du endpoint.
NETSCOPE_WEBHOOK_SECRET=your_webhook_secret_here

# Mets à "1" pour activer la boucle interne auto_scan (échantillonne
# sample_traffic.csv toutes les ~25s et agit si le score dépasse 80).
# Laissé vide/absent par défaut, comme les autres agents (voir
# launch_all.py --simulate).
# NETSCOPE_AUTO_SCAN=1

# Optionnel — URL du webhook CrisisBot, appelé à chaque isolement
# automatique. Valeur par défaut déjà correcte en local.
# CRISISBOT_URL=http://localhost:8878/api/webhook/incident

# NOTE : les anciennes variables ALERT_WEBHOOK_URL, RISK_THRESHOLD et
# API_PORT (présentes dans une version précédente de ce fichier) ne
# correspondent à rien dans le code actuel — le seuil de décision (50.0) et
# le seuil d'action automatique (80.0) sont définis directement dans
# scorer.py et auto_scan.py, pas via une variable d'environnement.
