# Copie ce fichier en ".env" et renseigne tes vrais tokens si besoin.
# ".env" est listé dans .gitignore — ne l'en retire jamais.
# Ce fichier ("*.example") est fait pour être partagé/commité : uniquement
# des placeholders ici, jamais une vraie clé.

# Optionnel. Sans cette clé, le message de communication interne du runbook
# utilise un texte de repli générique au lieu d'être rédigé par le LLM
# (voir llm_comms.py, FALLBACK_MESSAGE) — le runbook lui-même continue de
# fonctionner normalement.
# Clé gratuite, sans carte bancaire : https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Port du dashboard CrisisBot.
CRISISBOT_PORT=8878

# Notification Slack réelle (pas simulée) à la fin de chaque runbook.
# Sans cette variable, CrisisBot continue de fonctionner : le dashboard
# indique simplement "Slack non configuré" (voir notifications.py,
# is_slack_configured()) au lieu d'envoyer un vrai message.
# Crée un "Incoming Webhook" sur https://api.slack.com/apps pour ton canal :
# SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url_here
